    <style>
        @page {
            size: A4;
            margin: 2cm 2.5cm 2cm 2.5cm;
        }
        body {
            font-family: 'Times New Roman', serif;
            font-size: 13pt;
            line-height: 1.6;
            color: #222;
        }
        .cover-page {
            text-align: center;
            padding-top: 120px;
            page-break-after: always;
        }
        .cover-page .logo-box {
            width: 120px;
            height: 120px;
            border: 3px solid #2563eb;
            border-radius: 20px;
            margin: 0 auto 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            color: #2563eb;
        }
        .cover-title {
            font-size: 28pt;
            font-weight: bold;
            color: #1e293b;
            margin-bottom: 10px;
            text-transform: uppercase;
        }
        .cover-subtitle {
            font-size: 18pt;
            color: #2563eb;
            margin-bottom: 40px;
        }
        .cover-info {
            font-size: 13pt;
            color: #555;
            margin-top: 60px;
        }
        .cover-info table {
            margin: 0 auto;
            border-collapse: collapse;
        }
        .cover-info td {
            padding: 6px 16px;
            text-align: left;
        }
        .cover-info td:first-child {
            font-weight: bold;
            color: #333;
        }
        .cover-line {
            width: 200px;
            height: 4px;
            background: #2563eb;
            margin: 30px auto;
        }
        
        h1 {
            font-size: 22pt;
            color: #1e293b;
            border-bottom: 3px solid #2563eb;
            padding-bottom: 8px;
            margin-top: 40px;
            page-break-before: always;
        }
        h1:first-of-type {
            page-break-before: auto;
        }
        h2 {
            font-size: 16pt;
            color: #2563eb;
            margin-top: 24px;
            border-left: 4px solid #2563eb;
            padding-left: 12px;
        }
        h3 {
            font-size: 14pt;
            color: #334155;
            margin-top: 18px;
        }
        h4 {
            font-size: 13pt;
            color: #475569;
            margin-top: 14px;
        }
        
        table {
            border-collapse: collapse;
            width: 100%;
            margin: 12px 0 20px;
            font-size: 11pt;
        }
        table th {
            background-color: #2563eb;
            color: white;
            font-weight: bold;
            padding: 10px 12px;
            text-align: left;
            border: 1px solid #1d4ed8;
        }
        table td {
            padding: 8px 12px;
            border: 1px solid #ddd;
            vertical-align: top;
        }
        table tr:nth-child(even) td {
            background-color: #f8fafc;
        }
        table tr:hover td {
            background-color: #eff6ff;
        }
        
        .highlight-box {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-left: 4px solid #2563eb;
            padding: 14px 18px;
            margin: 16px 0;
            border-radius: 4px;
        }
        .warning-box {
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-left: 4px solid #f59e0b;
            padding: 14px 18px;
            margin: 16px 0;
            border-radius: 4px;
        }
        .success-box {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-left: 4px solid #22c55e;
            padding: 14px 18px;
            margin: 16px 0;
            border-radius: 4px;
        }
        .danger-box {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-left: 4px solid #ef4444;
            padding: 14px 18px;
            margin: 16px 0;
            border-radius: 4px;
        }
        
        ul, ol {
            margin: 8px 0 16px 20px;
        }
        li {
            margin-bottom: 6px;
        }
        
        .check { color: #22c55e; font-weight: bold; }
        .cross { color: #ef4444; font-weight: bold; }
        .badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 10pt;
            font-weight: bold;
        }
        .badge-blue { background: #dbeafe; color: #1d4ed8; }
        .badge-green { background: #dcfce7; color: #16a34a; }
        .badge-yellow { background: #fef9c3; color: #a16207; }
        .badge-red { background: #fee2e2; color: #dc2626; }
        
        .toc a {
            color: #2563eb;
            text-decoration: none;
        }
        .toc li {
            margin-bottom: 4px;
        }
        
        .flow-diagram {
            text-align: center;
