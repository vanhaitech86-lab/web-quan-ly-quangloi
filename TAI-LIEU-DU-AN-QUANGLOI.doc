    <tr><td>UI Framework</td><td>Bootstrap 5.3</td><td>Vue.js + Vuetify / React + Ant Design</td></tr>
    <tr><td>Biểu đồ</td><td>Chart.js</td><td>Chart.js / ECharts</td></tr>
    <tr><td>Icons</td><td>Bootstrap Icons</td><td>Bootstrap Icons / Material Icons</td></tr>
