    <tr><td>4</td><td>Điện thoại</td><td>Phone</td><td><span class="check">&#10003;</span></td><td>Validation SĐT Việt Nam</td></tr>
    <tr><td>5</td><td>Email</td><td>Email</td><td></td><td>Validation email</td></tr>
    <tr><td>6</td><td>Địa chỉ</td><td>Text + Dropdown</td><td></td><td>Tỉnh/Thành &rarr; Quận/Huyện &rarr; Phường/Xã</td></tr>
    <tr><td>7</td><td>Phân loại</td><td>Dropdown</td><td></td><td>VIP / Thường / Tiềm năng</td></tr>
    <tr><td>8</td><td>Nguồn KH</td><td>Dropdown</td><td></td><td>Online / Giới thiệu / Quảng cáo / Khác</td></tr>
    <tr><td>9</td><td>Nhân viên phụ trách</td><td>Dropdown</td><td></td><td>Danh sách nhân viên</td></tr>
    <tr><td>10</td><td>Ghi chú</td><td>Textarea</td><td></td><td>Ghi chú nội bộ</td></tr>
    <tr><td>11</td><td>Ngày tạo</td><td>DateTime (hệ thống)</td><td></td><td>Tự động ghi nhận</td></tr>
</table>

<h2>5.2 Chức năng</h2>
<ul>
    <li>Thêm mới / Sửa / Xóa / Xem chi tiết khách hàng</li>
    <li>Tìm kiếm theo tên, SĐT, email, công ty</li>
    <li>Lọc theo phân loại, nguồn, nhân viên phụ trách</li>
    <li>Export danh sách ra Excel</li>
    <li>Import khách hàng từ file Excel</li>
    <li>Xem lịch sử giao dịch (đơn hàng, hóa đơn, thiết bị liên quan)</li>
</ul>

