    <tr><td>1</td><td>Mã SP</td><td>Text (tự sinh)</td><td><span class="check">&#10003;</span></td><td>Format: SP-XXXXX</td></tr>
    <tr><td>2</td><td>Tên sản phẩm</td><td>Text</td><td><span class="check">&#10003;</span></td><td></td></tr>
    <tr><td>3</td><td>Hình ảnh</td><td>File Upload</td><td></td><td>Hỗ trợ nhiều ảnh, thumbnail</td></tr>
    <tr><td>4</td><td>Dòng sản phẩm</td><td>Dropdown</td><td></td><td>Danh mục dòng SP</td></tr>
    <tr><td>5</td><td>Đơn giá bán</td><td>Currency</td><td><span class="check">&#10003;</span></td><td>Giá bán lẻ</td></tr>
    <tr><td>6</td><td>Giá nhập</td><td>Currency</td><td></td><td>Giá mua từ NCC</td></tr>
    <tr><td>7</td><td>Đơn vị tính</td><td>Dropdown</td><td><span class="check">&#10003;</span></td><td>Cái / Bộ / Hộp / Thùng / ...</td></tr>
    <tr><td>8</td><td>Tồn kho</td><td>Number (tính)</td><td></td><td>Tự tính từ module Kho</td></tr>
